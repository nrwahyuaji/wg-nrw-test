# Salin ke /etc/wgpanel.env (chmod 600, owner root:wgpanel). Arti tiap baris: Plan/DESIGN.md §9.1
WGPANEL_ENV=production
WGPANEL_LISTEN=127.0.0.1:8091
WGPANEL_DB_PATH=/var/lib/wgpanel/wgpanel.db
# WAJIB. Buat sekali: openssl rand -base64 32. SIMPAN TERPISAH dari backup DB (DEPLOY.md §7).
WGPANEL_SECRET_KEY=
WGPANEL_WG_CONF_DIR=/etc/wireguard
# CIDR reverse proxy yang dipercaya untuk X-Forwarded-For, mis. 127.0.0.1/32
WGPANEL_TRUSTED_PROXIES=127.0.0.1/32
WGPANEL_ALLOWED_ORIGINS=
WGPANEL_BACKUP_DIR=/var/lib/wgpanel/backups
WGPANEL_TELEGRAM_BOT_TOKEN=
WGPANEL_METRICS_TOKEN=
