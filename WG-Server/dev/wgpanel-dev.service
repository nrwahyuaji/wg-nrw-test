# Unit DEV: wgpanel serve di dalam netns wgdev (lab, scripts/devlab.sh). Hanya untuk host development.
# Biner: /usr/local/lib/wgpanel-dev/wgpanel (dipasang `make dev-build`). Sengaja di luar /home: unit memakai
# ProtectHome=yes menyembunyikan seluruh /home dari unit, jadi biner tidak bisa dijalankan dari repo.
[Unit]
Description=WG-WebUI panel DEV (netns wgdev)
After=network-online.target wgpanel-lab.service
Requires=wgpanel-lab.service

[Service]
Type=simple
User=wgpanel
Group=wgpanel
EnvironmentFile=/etc/wgpanel-dev.env
ExecStart=/usr/local/lib/wgpanel-dev/wgpanel serve
NetworkNamespacePath=/run/netns/wgdev
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wgpanel-dev
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
UMask=0077
# Pengerasan tambahan (temuan G1-04 skor systemd-analyze security): filter syscall + isolasi proc/kernel.
# Diuji: TestApplyIdempotent PASS di bawah sandbox yang sama sebagai user wgpanel (8 Okt 2026).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
# ProcSubset=pid sengaja TIDAK dipakai: menyembunyikan /proc/sys sehingga health tidak bisa membaca
# ip_forward (F-5.4). /proc/sys tetap hanya-baca lewat ProtectKernelTunables=yes.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
