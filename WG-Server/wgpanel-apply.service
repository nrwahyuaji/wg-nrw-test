# Oneshot saat boot: bangun ulang semua interface WireGuard dari DB lalu keluar.
# Dipisah dari wgpanel.service supaya tunnel tetap pulih walaupun web panel gagal start (N-4).
[Unit]
Description=WG-WebUI apply (pulihkan interface WireGuard dari DB)
After=network-online.target
Wants=network-online.target
Before=wgpanel.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=wgpanel
Group=wgpanel
EnvironmentFile=/etc/wgpanel.env
ExecStart=/usr/local/bin/wgpanel apply
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wgpanel /etc/wireguard
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
UMask=0077
# Pengerasan tambahan (temuan G1-04 skor systemd-analyze security): filter syscall + isolasi proc/kernel.
# Diuji: TestApplyIdempotent PASS di bawah sandbox yang sama sebagai user wgpanel (8 Okt 2026).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectProc=invisible
# ProcSubset=pid sengaja TIDAK dipakai: menyembunyikan /proc/sys sehingga health tidak bisa membaca
# ip_forward (F-5.4). /proc/sys tetap hanya-baca lewat ProtectKernelTunables=yes.
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
