# Unit web panel WG-WebUI. VPN TIDAK bergantung pada unit ini (lihat wgpanel-apply.service).
# Pasang: DEPLOY.md §3.
[Unit]
Description=WG-WebUI panel (wgpanel serve)
Documentation=file:///opt/wgpanel/README.md
After=network-online.target wgpanel-apply.service
Wants=network-online.target

[Service]
Type=simple
User=wgpanel
Group=wgpanel
EnvironmentFile=/etc/wgpanel.env
ExecStart=/usr/local/bin/wgpanel serve
Restart=on-failure
RestartSec=3

# Hak minimal: hanya CAP_NET_ADMIN (mengatur WireGuard, alamat, rute). Dibuktikan di DESIGN.md §10.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/wgpanel /etc/wireguard
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
# Pengerasan tambahan (temuan G1-04 skor systemd-analyze security): filter syscall + isolasi proc/kernel.
# Diuji: TestApplyIdempotent PASS di bawah sandbox yang sama sebagai user wgpanel (8 Okt 2026).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ProtectKernelLogs=yes
ProtectProc=invisible
# ProcSubset=pid sengaja TIDAK dipakai: menyembunyikan /proc/sys sehingga health tidak bisa membaca
# ip_forward (F-5.4). /proc/sys tetap hanya-baca lewat ProtectKernelTunables=yes.
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
